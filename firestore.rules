rules_version = '2';
// Multi-tenancy Firestore Security Rules — Faz 6.
//
// Source of truth: request.auth.token.companyId / isSuperAdmin (set by
// the onUserClaimSync Cloud Function in Faz 2; backfilled by
// scripts/sync-claims.js).
//
// Two tiers:
//   - "strict" collections (Faz 4 query refactor done) → inCompany() / writingInCompany()
//   - "loose" collections (referenced in code but not yet scoped) → isSignedIn()
//     These carry a TODO; they'll be tightened in follow-up PRs as their
//     queries are migrated to scopedQuery().
//
// Unknown collections default-deny per Firestore rules semantics.

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------
    // Helpers
    // -----------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.isSuperAdmin == true;
    }
    function userCompany() {
      return request.auth.token.companyId;
    }
    function docCompany() {
      return resource.data.companyId;
    }
    function newDocCompany() {
      return request.resource.data.companyId;
    }
    function inCompany() {
      return isSignedIn() && (
        isSuperAdmin() ||
        !('companyId' in resource.data) ||
        docCompany() == userCompany()
      );
    }
    function writingInCompany() {
      return isSignedIn() && (
        isSuperAdmin() ||
        !('companyId' in request.resource.data) ||
        newDocCompany() == userCompany()
      );
    }

    // -----------------------------
    // Users (kendi doc'u + admin + aynı şirket görebilir)
    // -----------------------------
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isSuperAdmin() ||
        (resource != null && resource.data.companyId == userCompany())
      );
      allow write: if isSignedIn() && (
        request.auth.uid == uid ||
        isSuperAdmin()
      );
    }

    // -----------------------------
    // STRICT tier — Faz 4 scoped queries
    // -----------------------------

    match /devices/{id}                       { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /depots/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
      // Subcollection: parent doc already scoped; child reads inherit trust via auth.
      match /minMaxRules/{ruleId}             { allow read, write: if isSignedIn(); }
    }
    match /hospitals/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
      match /minMaxRules/{ruleId}             { allow read, write: if isSignedIn(); }
      match /subPoints/{spId}                 { allow read, write: if isSignedIn(); }
      match /stockCounts/{countId}            { allow read, write: if isSignedIn(); }
    }
    match /borcDepots/{id}                    { allow read: if inCompany(); allow write: if writingInCompany(); }

    // companyStats — Faz 5 pre-aggregated dashboard özet doc'u. Doc ID
    // companyId'ye eşittir. Yazma sadece Cloud Functions üzerinden
    // (admin SDK security rules'ı bypass eder).
    match /companyStats/{companyId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || companyId == userCompany()
      );
      allow write: if false;
    }

    // costSnapshots — anlık maliyet günlük snapshot doc'u. Doc ID = companyId.
    // Normalde her sabah 06:00 Cloud Function yazar (admin SDK rules'ı bypass eder),
    // ancak istemci fallback / "Yeniden hesapla" da aynı şirketin doc'unu yazabilir.
    match /costSnapshots/{companyId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || companyId == userCompany()
      );
      allow write: if isSignedIn() && (
        isSuperAdmin() || companyId == userCompany()
      );
    }
    match /depoStok/{id}                      { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /hospitalDeviceAssignments/{id}     { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /purchasingTasks/{id}               { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /deviceGroups/{id}                  { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /labPools/{id}                      { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /addressDefinitions/{id}            { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /personnelAvailability/{id}         { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /deviceFaultReports/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
      // Sub-history/notes etc. (varsa) parent scope altında.
      match /{path=**}                        { allow read, write: if isSignedIn(); }
    }
    match /deviceActionForms/{id}             { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /aplikasyonActionForms/{id}         { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /maintenancePlans/{id}              { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /maintenanceLogs/{id}               { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /deviceLabPools/{id}                { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /tuketimKayitlari/{id}              { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /shipments/{id}                     { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /efficiencyHistory/{id}             { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /barcodeFormats/{id}                { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /faultDefinitions/{id}              { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /depotStockCountSessions/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
      match /scannedItems/{itemId}            { allow read, write: if isSignedIn(); }
    }
    match /maliyetSayimSessions/{id}          { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /dutyShifts/{id}                    { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /irsaliyeFiles/{id}                 { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /productCodes/{id}                  { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /notifications/{id}                 { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /orders/{id}                        { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /personnel/{id}                     { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /personnelCostConfig/{id}           { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /personnelHistoryLogs/{id}          { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /personelGruplari/{id}              { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /personalStock/{id}                 { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /transfers/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
      match /items/{itemId}                   { allow read, write: if isSignedIn(); }
    }
    match /sparePartTransferLogs/{id}         { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /yedekParcaDepoStok/{id}            { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /yedekParcaDepoLog/{id}             { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /yedekParcaSiparisler/{id}          { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /borrowedSpareParts/{id}            { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /assets/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
      match /assetHistory/{logId}             { allow read, write: if isSignedIn(); }
      match /custodyHistory/{logId}           { allow read, write: if isSignedIn(); }
    }
    match /assetCategories/{id}               { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /efficiencyPools/{id}               { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /purchasingWorkflows/{id}           { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /userRequests/{id}                  { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /transferTemplates/{id}             { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /vehicles/{id}                      { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /testDefinitions/{id}               { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /testAutoSumDefinitions/{id}        { allow read: if inCompany(); allow write: if writingInCompany(); }
    // Product-code definitions are shared catalogs across every company.
    match /def_brands/{id}                    { allow read, write: if isSignedIn(); }
    match /def_labGroups/{id}                 { allow read, write: if isSignedIn(); }
    match /def_testGroups/{id}                { allow read, write: if isSignedIn(); }
    match /def_deviceGroups/{id}              { allow read, write: if isSignedIn(); }
    match /def_productGroups/{id}             { allow read, write: if isSignedIn(); }
    match /def_mainUnits/{id}                 { allow read, write: if isSignedIn(); }
    match /deviceBrandModels/{id}             { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /deviceModelDefinitions/{id}        { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /costCheckpoints/{id}               { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /shiftSchedules/{id}                { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /purchasingTaskDefinitions/{id}     { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /expensePeriods/{id}                { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /cihazUstuGecmisi/{id}              { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /kumulatifHesaplamaGecmisi/{id}     { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /qoreCalculationPendingFiles/{id}   { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /actionFormHistoryLogs/{id}         { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /actionFormPartReassignLogs/{id}    { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /postClosurePartChangeLogs/{id}     { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /nfcDisposalEvents/{id}             { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /minMaxHistory/{id}                 { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /minMaxPeriodConfigs/{id}           { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /trashBinRecords/{id}               { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /borcTransfers/{id}                 { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /ejectedKitRecords/{id}             { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /destroyedKitsReports/{id}          { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /digerFirmaArizalar/{id}            { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /productReturns/{id}                { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /overtimeRequests/{id}              { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /kumulatifRaporlar/{id}             { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /bekleyenIrsaliyeler/{id}           { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /depotBrandCountSessions/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
      match /items/{itemId}                   { allow read: if inCompany(); allow write: if writingInCompany(); }
    }
    match /depotBrandCountValidationLogs/{id} { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /malKabulTransactions/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
      match /lines/{lineId}                   { allow read, write: if isSignedIn(); }
    }
    // Yönetici stok adedi düzeltme iz kaydı (artış/azalış). Silinemez.
    match /stockAdjustmentLogs/{id} {
      allow read: if inCompany();
      allow create: if writingInCompany();
      allow update, delete: if false;
    }

    // -----------------------------
    // Seri No Defteri (serialLedger)
    //
    // `ürün kodu + seri no` başına TEK satır; her fiziksel birimin nerede
    // olduğunu ve hangi işlemlerden geçtiğini tutar. Mal kabul, transfer,
    // sipariş karşılama, tüketim, imha, borç ve depo sayımı bu koleksiyona
    // yazar; barkod okutulduğunda "bu birim daha önce işlem gördü mü" sorusu
    // buradan cevaplanır.
    //
    // Olaylar (events) değiştirilemez: bir kez yazılır, güncellenmez, silinmez.
    // Defter satırının kendisi güncellenebilir (son durum/konum burada tutulur),
    // fakat silinemez — sayımdan düşülen birim silinmez, `serbest` durumuna
    // geçer ve yeniden işlem görebilir.
    // -----------------------------
    match /serialLedger/{id} {
      allow read: if inCompany();
      allow create, update: if writingInCompany();
      allow delete: if isSuperAdmin();
      match /events/{eventId} {
        allow read: if inCompany();
        allow create: if writingInCompany();
        allow update, delete: if false;
      }
    }

    // Eski seri geçmişi. `serialLedger` devreye girene kadar yazılmaya devam
    // eder ve geriye dönük doldurma bu kayıtları okur. Belge kimliği seri
    // numarasının kendisi olduğu için üst belge çoğu zaman boştur; kapsam
    // kontrolü olay belgelerindeki `companyId` üzerinden yapılır.
    match /serialHistory/{serial} {
      allow read, write: if isSignedIn();
      match /events/{eventId}                 { allow read, write: if isSignedIn(); }
    }
    match /poolWarehouseStock/{id}            { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /routes/{id}                        { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /draftActionForms/{id}              { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /periodicPartChanges/{id}           { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /periodicPartChangeLogs/{id}        { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /archiveRacks/{id}                  { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /pendingCeomedIrsaliye/{id}         { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /totalEfficiencyRecords/{id}        { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /irsaliyeDosyalari/{id}             { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /consumableRequests/{id}            { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /sarfTransfers/{id}                 { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /teknikServisActionForms/{id}       { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /centralOrders/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
      match /logs/{logId}                     { allow read, write: if isSignedIn(); }
    }
    match /supplierOrders/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
    }
    match /hospitalShipmentPlans/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
    }
    // Lab-dönem tek doğruluk kaynağı: sayım / cihaz üstü / kümülatif.
    // Yazma Admin SDK üzerinden yapılır; client yalnızca okur.
    match /labPeriodSnapshots/{id} {
      allow read: if inCompany();
      allow write: if false;
    }

    // companies özel: id == userCompany() (her tenant kendi şirket dökümanını okur)
    // SuperAdmin tüm companies'i okur ve yazar.
    match /companies/{id} {
      allow read: if isSignedIn() && (isSuperAdmin() || id == userCompany());
      allow write: if isSuperAdmin();
    }

    // -----------------------------
    // LOOSE tier — not yet scoped (TODO: tighten as queries migrate)
    // -----------------------------
    // dailyConsumptionStats: Phase 2-M sonrası docId formatı
    // `${companyId}_${dateKey}` — companyId field doc'ta var, normal pattern.
    match /dailyConsumptionStats/{id}         { allow read: if inCompany(); allow write: if writingInCompany(); }

    match /pendingReturns/{id}                { allow read: if inCompany(); allow write: if writingInCompany(); }
    // AuditLogs: server-side `restore.ts` admin operation; SuperAdmin only.
    match /AuditLogs/{id} {
      allow read, write: if isSuperAdmin();
    }

    // -----------------------------
    // System & infrastructure
    // -----------------------------
    match /pushTokens/{token}                 { allow read, write: if isSignedIn(); }
    match /metadata/{id}                      { allow read, write: if isSignedIn(); }
    match /presence/{id}                      { allow read, write: if isSignedIn(); }

    // -----------------------------
    // Cari Ödeme / Qore Finance paneli — Faz 0 güvenlik modeli.
    //
    // Tenant izolasyonu: tüm koleksiyonlar inCompany() / writingInCompany()
    // ile korunur. Durum geçişleri (status field) client-side state-machine
    // tarafından doğrulanır (src/lib/cari-odeme/state-machine.ts).
    //
    // Audit log (cariAuditEvents): immutable — create-only, update/delete
    // yasak. Finansal işlemlerin tüm geçmişi burada tutulur.
    // -----------------------------
    match /cariPayments/{id} {
      allow read: if inCompany();
      allow create: if writingInCompany();
      allow update: if writingInCompany();
      allow delete: if isSuperAdmin();
    }
    match /cariInvoices/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
    }
    match /cariReceipts/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
    }
    match /cariLedgerEntries/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
    }
    match /cariBankTransactions/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
    }
    match /cariExchangeRates/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
    }
    match /cariBudgetPlans/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
    }
    match /cariOperationalCostLinks/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
    }
    match /cariPaymentTemplates/{id}          { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /cariBankAccounts/{id}              { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /cariFirmalar/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
      match /ibans/{ibanId}                   { allow read: if inCompany(); allow write: if writingInCompany(); }
      match /history/{historyId}              { allow read: if inCompany(); allow write: if writingInCompany(); }
    }
    match /cariDepartments/{id} {
      allow read: if inCompany();
      allow write: if writingInCompany();
      match /history/{historyId}              { allow read: if inCompany(); allow write: if writingInCompany(); }
    }

    // Audit log — immutable: create-only, no update or delete allowed.
    match /cariAuditEvents/{id} {
      allow read: if inCompany();
      allow create: if writingInCompany();
      allow update, delete: if false;
    }

    // Satın-Alma Planlama görevleri (to-do / takvim).
    match /planlamaGorevler/{id}              { allow read: if inCompany(); allow write: if writingInCompany(); }

    // Takvim entegrasyonu — OAuth refresh token'ları ve etkinlik eşlemeleri.
    // Hassas kimlik bilgileri içerir; TÜM client erişimi reddedilir. Yalnızca
    // Admin SDK (sunucu tarafı API route'ları) okur/yazar.
    match /calendarConnections/{uid}/{document=**} { allow read, write: if false; }
    match /calendarOAuthStates/{id}            { allow read, write: if false; }

    // -----------------------------
    // Kuralı eksik kalmış koleksiyonlar (Faz 7)
    //
    // Aşağıdaki koleksiyonlar uygulama kodunda TARAYICIDAN okunup yazılıyordu
    // fakat bu dosyada hiçbir `match` blokları yoktu. Firestore tanımsız
    // koleksiyonları varsayılan olarak REDDEDER; yani bu kural dosyası
    // yayınlandığında ilgili ekranlar (kısayollar, rota planlayıcı, NFC lot
    // etiketleri, ceomed entegrasyonu, kullanım paneli seri anlık görüntüleri…)
    // sessizce çalışmaz hâle geliyordu.
    //
    // `inCompany()` / `writingInCompany()` geriye dönük uyumludur: `companyId`
    // alanı TAŞIMAYAN eski belgeler okunmaya ve yazılmaya devam eder
    // (helper'lardaki `!('companyId' in ...)` koşulu). Yalnızca başka bir
    // şirkete ait olduğu AÇIKÇA etiketlenmiş belgeler engellenir.
    // -----------------------------
    match /shortcuts/{id}                     { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /shortcutRuns/{id}                  { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /shortcutRunRequests/{id}           { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /shortcutRunLogs/{id}               { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /routeRequests/{id}                 { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /routeSequences/{id}                { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /lotNfcDefinitions/{id}             { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /lot_tags/{id}                      { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /labTransferDates/{id}              { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /labManualSerialSnapshots/{id}      { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /depoSayimBackfillLogs/{id}         { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /yedekParcaDepoMinMax/{id}          { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /ceomedDepoStok/{id}                { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /ceomedSevkiyatRequests/{id}        { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /ceomedSevkiyatResults/{id}         { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /isAnaliziVerileri/{id}             { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /analysis_results/{id}              { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /actionFormNumberCounters/{id}      { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /qoreCalculationPeriodCounters/{id} { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /notificationLogs/{id}              { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /ordersArchive/{id}                 { allow read: if inCompany(); allow write: if writingInCompany(); }
    // Şirketten bağımsız uygulama ayarları / referans verileri.
    match /appSettings/{id}                   { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /settings/{id}                      { allow read: if inCompany(); allow write: if writingInCompany(); }
    match /config_hospitals/{id}              { allow read: if inCompany(); allow write: if writingInCompany(); }

    // -----------------------------
    // Faz 7 tamamlandı — geçici güvenlik ağı KALDIRILDI.
    //
    // Geçiş sırasında, kuralı unutulmuş bir koleksiyonun kullanıcıyı
    // kilitlemesini önlemek için `match /{col}/{docId}` + `/{rest=**}` blokları
    // vardı (koşulları yine `inCompany()` idi, kiracı izolasyonunu
    // zayıflatmıyordu). Üretimde "denied" kaydı gelmediği doğrulandıktan sonra
    // silindi.
    //
    // ARTIK: `match` bloğu olmayan koleksiyon varsayılan olarak REDDEDİLİR.
    // Yeni bir koleksiyon eklerken kuralını da eklemeyi ATLAMAYIN — aksi hâlde
    // ilgili ekran üretimde sessizce çalışmaz ve bu ancak kullanıcı şikâyetiyle
    // fark edilir. Ayrıntı: docs/firestore-rules-rollout.md
    // -----------------------------

    // Faz 1 placeholder — koleksiyonlar oluşturulunca aktifleştirilecek:
    // match /cariInvoices/{id}      { allow read: if inCompany(); allow write: if writingInCompany(); }
    // match /cariReceipts/{id}      { allow read: if inCompany(); allow write: if writingInCompany(); }
    // match /cariLedgerEntries/{id} { allow read: if inCompany(); allow write: if writingInCompany(); }
  }
}
