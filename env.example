# Qore Environment Variables
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun
# cp env.example .env.local

# Claude AI API Key (Zorunlu)
# https://console.anthropic.com/ adresinden API anahtarı alabilirsiniz
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Firebase Configuration (Mevcut yapılandırmanızı kullanın)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
