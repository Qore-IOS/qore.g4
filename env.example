# Qore Environment Variables
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun
# cp env.example .env.local

# Gemini API Key (Zorunlu)
# https://aistudio.google.com/app/apikey adresinden API anahtarı alabilirsiniz
GEMINI_API_KEY=your_gemini_api_key_here
# Alternatif olarak GOOGLE_API_KEY da kullanılabilir
# GOOGLE_API_KEY=your_google_api_key_here

# Opsiyonel model seçimi
# GEMINI_MODEL=gemini-2.0-flash

# Firebase Configuration (Mevcut yapılandırmanızı kullanın)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Push notification (FCM) Web Push Certificate / VAPID Key
# Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
# Bu anahtar olmadan tarayıcı push bildirimleri çalışmaz.
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Döviz API (FreeCurrencyAPI)
# NEXT_PUBLIC_FREECURRENCY_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Takvim Entegrasyonu (Satın-Alma Planlama → Google Takvim / Outlook)
# Planlama panelindeki "Takvim" butonu bu değerler tanımlıysa çalışır.
# ─────────────────────────────────────────────────────────────────────

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
#   (Web application). Google Calendar API'yi etkinleştirin.
#   Yetkili yönlendirme URI'si: https://<alan-adiniz>/api/calendar/google/callback
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Entra ID (Azure) → App registrations → yeni kayıt.
#   API izinleri: Microsoft Graph → Calendars.ReadWrite, User.Read, offline_access
#   Yönlendirme URI'si: https://<alan-adiniz>/api/calendar/microsoft/callback
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=
# Çoklu kiracı için "common", tek kiracı için tenant ID (varsayılan: common)
# MICROSOFT_CALENDAR_TENANT=common

# Etkinliklerin saat dilimi (varsayılan Europe/Istanbul)
# CALENDAR_TIMEZONE=Europe/Istanbul

# OAuth yönlendirme URI'lerinin türetileceği taban adres.
# Verilmezse gelen istekten (x-forwarded-host) otomatik türetilir.
# APP_BASE_URL=https://app.qore.example

# Refresh token'ları Firestore'da AES-256-GCM ile şifrelemek için gizli anahtar
# (opsiyonel ama önerilir). Tanımlı değilse token'lar düz metin saklanır.
# CALENDAR_TOKEN_SECRET=
