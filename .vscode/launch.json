
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Server-side",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    },
    {
      "name": "Next.js: Client-side",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:9002"
    },
    {
      "name": "Next.js: Full-stack",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    }
  ]
}
