CEOMED_BASE_URL=http://192.168.1.5:8081
CEOMED_EPOSTA=merkez
CEOMED_PAROLA=12345
# Firestore sync için:
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
# Multi-tenancy: bu Ceomed kurulumunun ait olduğu firma id'si.
# Yazılan tüm dokümanlar (pendingCeomedIrsaliye, ceomedDepoStok) bu tag ile
# yazılır; aksi halde panel scopedQuery'leri veriyi göstermez.
CEOMED_COMPANY_ID=your-company-id

# ── Sürekli açık watcher (watch.js / run-watch.bat) ──────────────────────────
# Ceomed API'si push/webhook sağlamaz; bu değerler yoklama aralıklarıdır.
CEOMED_WATCH_IRSALIYE_SEC=60     # irsaliye yoklama aralığı (saniye)
CEOMED_WATCH_DEPO_SEC=120        # depo stoğu yoklama aralığı (saniye)
CEOMED_WATCH_LOOKBACK_DAYS=7     # her turda kaç gün geriye bakılsın
CEOMED_AUTO_TRANSFER=1           # 0 = "KURUMA SEVK EDILDI" irsaliyelerin
                                 #     otomatik laboratuvar aktarımı kapalı
