{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-dist",
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "types": ["node"],
    "rootDir": ".",
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "tests/**/*.test.ts",
    "src/lib/utils.ts",
    "src/lib/mal-kabul/**/*.ts",
    "src/lib/lojistik/**/*.ts",
    "src/lib/logger.ts",
    "src/lib/test-cost-calculator.ts",
    "src/lib/types.ts",
    "src/lib/tracking.ts",
    "src/@types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".test-dist"
  ]
}
