{
  "rules": {
    "users": {
      "$uid": {
        "allow read, write": "if request.auth != null && (request.auth.uid == $uid || get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin')"
      }
    },
    "deviceFaultReports": {
      "allow read": "if true;",
      "allow write": "if request.auth != null;"
    },
    // Sadece bildirimleri ve diğer gerekli koleksiyonları yetkilendirilmiş kullanıcılara aç
    "notifications/{notificationId}": {
      "allow read, write": "if request.auth != null;"
    },
    "pushTokens/{token}": {
       "allow read, write": "if request.auth != null;"
    },
    "labPools/{poolId}": {
        "allow read, write": "if request.auth != null;"
    }
  }
}
