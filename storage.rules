rules_version = '2';

// By default, deny all reads and writes
service firebase.storage {
  match /b/{bucket}/o {

    // Allow authenticated users to read/write their own files in the 'reports' folder.
    // The path matches the structure: /reports/some_user_id/some_file.pdf
    match /reports/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to read/write invoice files in the 'irsaliyeler' folder.
    // All authenticated users can read (for shared access), only owner can write/delete.
    match /irsaliyeler/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Device images - publicly readable (migrated from public/ directory).
    // Only the admin migration endpoint writes to this path via Admin SDK.
    match /device-images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Part change images (removed/used parts) - authenticated read.
    match /removed-parts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /used-parts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // User request images - authenticated users can upload, all authenticated can read
    match /user-requests/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    function isCalculationCompany(companyId) {
      return request.auth != null && (
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.companyId == companyId
      );
    }

    // Temporary calculation uploads are isolated by company, immutable after
    // creation, and bounded to the report file formats accepted by the UI.
    match /qore-calculation-pending-files/{companyId}/{pendingId}/{fileId} {
      allow read, delete: if isCalculationCompany(companyId);
      allow create: if isCalculationCompany(companyId)
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.metadata.companyId == companyId
        && request.resource.metadata.pendingCalculationId == pendingId
        && request.resource.contentType.matches(
          'application/pdf|text/.*|application/csv|application/vnd.ms-excel|application/octet-stream'
        );
      allow update: if false;
    }

    // Deny access to all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
