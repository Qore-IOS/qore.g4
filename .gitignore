# misc
.DS_Store
*.pem
scripts/ceomed-sync/set-env.bat
# Ceomed makinesinde uretilen calisma ciktilari. Operator araclari her kosuda
# <betik-adi>.log yaziyor; bunlar makineye ozgu ve cogu zaman ortam bilgisi
# (yol, proje kimligi, servis hesabi e-postasi) iceriyor — repoya girmemeli.
scripts/ceomed-sync/*.log
scripts/ceomed-sync/.sync-state.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

